# -----------------------------------------------------------------------------
# Zoo AI Operational Intelligence — env template
# Copy to `.env.local` for local dev. Never commit real secrets.
# -----------------------------------------------------------------------------

# Node runtime
NODE_ENV=development

# NextAuth (Step 4)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-32-char-random-string

# Postgres (Step 3) — via docker-compose or Neon
DATABASE_URL=postgresql://zoo:zoo@localhost:5432/zoo_ai?schema=public

# Anthropic Claude (Step 8+)
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Proprietary component integrations — OAuth 2.0 client credentials
# Base URLs default to localhost while the platform teams host services locally.
# -----------------------------------------------------------------------------

# OIP (Organizational Knowledge Assistant — Step 8)
OIP_BASE_URL=http://localhost:4001
OIP_TOKEN_URL=http://localhost:4001/oauth/token
OIP_CLIENT_ID=
OIP_CLIENT_SECRET=

# Agent Builder (Incident response planning — Step 10)
AGENT_BASE_URL=http://localhost:4002
AGENT_TOKEN_URL=http://localhost:4002/oauth/token
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# ProcureChain (Procurement — Step 11)
PROCURECHAIN_BASE_URL=http://localhost:4003
PROCURECHAIN_TOKEN_URL=http://localhost:4003/oauth/token
PROCURECHAIN_CLIENT_ID=
PROCURECHAIN_CLIENT_SECRET=

# Dashboard (Executive analytics — Step 13)
DASHBOARD_BASE_URL=http://localhost:4004
DASHBOARD_TOKEN_URL=http://localhost:4004/oauth/token
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=

# AI Squad Portal (identity federation — Step 4/6)
PORTAL_BASE_URL=http://localhost:4005
PORTAL_TOKEN_URL=http://localhost:4005/oauth/token
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=

# Feature flags
USE_MOCK_ADAPTERS=true
